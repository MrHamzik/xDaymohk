# =============================================================================
# Даймохк — переменные окружения
# -----------------------------------------------------------------------------
# Скопируйте этот файл в .env.local для разработки, а на Vercel заведите те же
# ключи в Project → Settings → Environment Variables.
#
# Правило одно: всё, что НЕ начинается с NEXT_PUBLIC_, остаётся на сервере.
# Переменные с префиксом NEXT_PUBLIC_ попадают в браузер и видны любому —
# класть туда секреты нельзя.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase — обязательно
# -----------------------------------------------------------------------------
# Project Settings → API. URL и anon-ключ публичные по замыслу: доступ к данным
# ограничивает RLS, а не секретность ключа.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role обходит RLS полностью. Только сервер: удаление аккаунта,
# блокировки, выдача прав, рассылка писем. Никогда не NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Вход через Google включается в Supabase → Authentication → Providers → Google.
# Client ID и Client Secret хранятся в Supabase, в этом файле их быть не должно.

# -----------------------------------------------------------------------------
# 2. Адрес сайта
# -----------------------------------------------------------------------------
# Нужен для ссылок в письмах, OG-разметки и редиректов после входа.
# Локально — http://localhost:3000, на проде — боевой домен без слэша в конце.
NEXT_PUBLIC_SITE_URL=https://daymohk.xyz

# -----------------------------------------------------------------------------
# 3. Ограничение частоты запросов (Upstash Redis) — рекомендуется на проде
# -----------------------------------------------------------------------------
# Без этих двух ключей счётчики живут в памяти процесса. На Vercel каждый
# запрос может попасть в новый экземпляр функции, где счётчик пустой, —
# то есть защита от перебора и спама обходится сама собой.
#
# Где взять: console.upstash.com → Create Database (регион ближе к eu-central) →
# вкладка REST API → UPSTASH_REDIS_REST_URL и UPSTASH_REDIS_REST_TOKEN.
# Бесплатного тарифа селу хватает с большим запасом.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# -----------------------------------------------------------------------------
# 4. Обслуживание заданий по расписанию
# -----------------------------------------------------------------------------
# Общий секрет между Vercel Cron и /api/tasks/maintenance: без него любой
# смог бы дёргать уборку просроченных заданий. Придумайте длинную случайную
# строку, например: openssl rand -hex 32
TASKS_CRON_SECRET=your-long-random-string

# -----------------------------------------------------------------------------
# 5. Карты и адреса — необязательно
# -----------------------------------------------------------------------------
# DaData: подсказки российских адресов. Токен серверный, в браузер не уходит.
DADATA_API_TOKEN=your-dadata-api-token

# OSRM: построение маршрутов. Публичный сервер годится для проверки, но он
# без гарантий по доступности — на проде лучше поднять свой в регионе.
OSRM_ROUTER_URL=https://router.project-osrm.org

# -----------------------------------------------------------------------------
# 6. Пожертвования CloudTips — необязательно
# -----------------------------------------------------------------------------
# Секрет из настроек вебхука CloudTips. Адрес вебхука указывается там же:
# https://your-domain/api/donations/cloudtips
CLOUDTIPS_WEBHOOK_SECRET=your-cloudtips-webhook-secret

# -----------------------------------------------------------------------------
# 7. Sentry — необязательно
# -----------------------------------------------------------------------------
# Сбор ошибок. DSN не секрет (он уходит в браузер), а вот org/project нужны
# только сборке для выгрузки source maps.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
