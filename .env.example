# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Enable Google in Supabase Authentication → Providers → Google.
# Google Client ID and Client Secret are stored in Supabase, not in this file.

# Optional server-only DaData token for Russian address suggestions.
DADATA_API_TOKEN=your-dadata-api-token

# Optional server-side OSRM router. A regional self-hosted URL is recommended for production.
OSRM_ROUTER_URL=https://router.project-osrm.org

# Server-only variable for account deletion API. Never expose it as NEXT_PUBLIC_...
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only secret from CloudTips webhook settings.
# Configure the webhook URL as https://your-domain/api/donations/cloudtips
CLOUDTIPS_WEBHOOK_SECRET=your-cloudtips-webhook-secret
